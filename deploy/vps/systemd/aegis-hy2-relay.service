[Unit]
Description=Aegis HY2 UDP ingress relay
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/default/aegis-hy2-relay
ExecStart=/bin/sh -ec '/usr/sbin/sysctl -w net.ipv4.ip_forward=1; /usr/sbin/iptables -t nat -C PREROUTING -p udp --dport "$LISTEN_PORT" -j DNAT --to-destination "$TARGET_HOST:$TARGET_PORT" 2>/dev/null || /usr/sbin/iptables -t nat -I PREROUTING 1 -p udp --dport "$LISTEN_PORT" -j DNAT --to-destination "$TARGET_HOST:$TARGET_PORT"; /usr/sbin/iptables -t nat -C POSTROUTING -p udp -d "$TARGET_HOST" --dport "$TARGET_PORT" -j MASQUERADE 2>/dev/null || /usr/sbin/iptables -t nat -I POSTROUTING 1 -p udp -d "$TARGET_HOST" --dport "$TARGET_PORT" -j MASQUERADE; /usr/sbin/iptables -C FORWARD -p udp -d "$TARGET_HOST" --dport "$TARGET_PORT" -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I FORWARD 1 -p udp -d "$TARGET_HOST" --dport "$TARGET_PORT" -j ACCEPT; /usr/sbin/iptables -C FORWARD -p udp -s "$TARGET_HOST" --sport "$TARGET_PORT" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || /usr/sbin/iptables -I FORWARD 1 -p udp -s "$TARGET_HOST" --sport "$TARGET_PORT" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT'
ExecStop=/bin/sh -c '/usr/sbin/iptables -t nat -D PREROUTING -p udp --dport "$LISTEN_PORT" -j DNAT --to-destination "$TARGET_HOST:$TARGET_PORT" 2>/dev/null || true; /usr/sbin/iptables -t nat -D POSTROUTING -p udp -d "$TARGET_HOST" --dport "$TARGET_PORT" -j MASQUERADE 2>/dev/null || true; /usr/sbin/iptables -D FORWARD -p udp -d "$TARGET_HOST" --dport "$TARGET_PORT" -j ACCEPT 2>/dev/null || true; /usr/sbin/iptables -D FORWARD -p udp -s "$TARGET_HOST" --sport "$TARGET_PORT" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
