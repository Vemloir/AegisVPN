# Scoped token: DNS Edit only for the single AegisVPN zone.
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_ZONE_ID=CHANGE_ME
CLOUDFLARE_ZONE_NAME=aegisvpn.org

# Only these exact records may be changed. Cloudflare proxying is always off.
CLOUDFLARE_FAILOVER_RECORDS=aegisvpn.org,www.aegisvpn.org,sub.aegisvpn.org,control.aegisvpn.org
FAILOVER_TARGET_IPV4=CHANGE_ME
# Leave empty unless both control hosts have a working, tested IPv6 address.
FAILOVER_TARGET_IPV6=

PATRONI_PRIMARY_HEALTH_URL=https://127.0.0.1:8008/primary
PATRONI_TLS_CA=/tls/ca.crt
PATRONI_TLS_CERT=/tls/client.crt
PATRONI_TLS_KEY=/tls/client.key
APPLICATION_HEALTH_URL=http://127.0.0.1:8080/health
CLOUDFLARE_ROLLBACK_FILE=/var/lib/aegis-ha/cloudflare-rollback.json
