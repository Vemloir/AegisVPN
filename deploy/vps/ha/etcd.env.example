# One copy per server. Never expose 2379/2380/5432/8008 beyond these three IPs.
PL_HA_IP=203.0.113.10
USA_HA_IP=203.0.113.20
GERMANY_ETCD_IP=203.0.113.30

# pl-etcd / us-etcd / de-etcd, unique on each host.
HA_NODE_NAME=pl-etcd
HA_BIND_IP=203.0.113.10
PATRONI_NAME=pl-postgres

ETCD_INITIAL_CLUSTER=pl-etcd=https://203.0.113.10:2380,us-etcd=https://203.0.113.20:2380,de-etcd=https://203.0.113.30:2380
ETCD_HOSTS=203.0.113.10:2379,203.0.113.20:2379,203.0.113.30:2379
ETCD_INITIAL_CLUSTER_STATE=new

POSTGRES_SUPERUSER_PASSWORD=replace-me
POSTGRES_REPLICATION_PASSWORD=replace-me
