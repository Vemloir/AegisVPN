# Both application hosts connect only through their local HAProxy. TLS still
# terminates at PostgreSQL; sslmode=verify-full validates the Patroni member.
DATABASE_URL=postgresql+asyncpg://aegis:CHANGE_ME@127.0.0.1:5433/aegis?ssl=require
LEADER_DATABASE_URL=postgresql://aegis:CHANGE_ME@127.0.0.1:5433/aegis?sslmode=require

# Keep both API stacks online. Only the advisory-lock holder consumes polling.
TELEGRAM_MODE=polling
