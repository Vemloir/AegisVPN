XRAY_RUN_MODE=internal
XRAY_CONFIG_PATH=/data/xray-config.json
XRAY_PORT=443
REALITY_DEST=gateway.icloud.com:443
REALITY_SERVER_NAME=gateway.icloud.com
HOST_IP=vpn.example.com
XHTTP_MODE=packet-up
# Outbound node control uses ordinary HTTPS/TCP 443 with a per-node mTLS
# identity and bearer token. New nodes start in observe; after the central
# desired/applied generation and digest match, switch to apply and bind the
# legacy Agent API to loopback.
CONTROL_MODE=observe
CONTROL_URLS=https://control.example.com
CONTROL_TOKEN_FILE=/data/control/token
CONTROL_CLIENT_CERT=/data/control/client.crt
CONTROL_CLIENT_KEY=/data/control/client.key
CONTROL_CA_CERT=/data/control/ca.crt
AGENT_BIND_HOST=0.0.0.0
