# Replace the email and domains below with your own before deploying.
{
    email you@example.com
}

http://vpn.example.com {
    redir https://vpn.example.com:8443{uri}
}

https://vpn.example.com:8443 {
    reverse_proxy 127.0.0.1:8080
}

# Legacy subscription hostname/port. Existing clients keep polling the URL
# they originally imported, so this alias must survive an apex-site migration.
https://api.site.example.com:8443 {
    reverse_proxy 127.0.0.1:8080
}

# The Telegram Login Widget only works on the ONE domain registered for the bot
# via BotFather /setdomain — on any other host it renders "Bot domain invalid".
# Serving the site on both the apex and www therefore breaks sign-in for whoever
# lands on www; www must redirect, not serve.
www.site.example.com {
    redir https://site.example.com{uri} permanent
}

# Public website: static SPA + its API.
site.example.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://t.me https://*.telegram.org; font-src 'self' data:; connect-src 'self'; frame-src https://telegram.org https://oauth.telegram.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Frame-Options "DENY"
        -Server
    }

    # Hashed bundles never change under the same name: cache forever.
    # Everything else (index.html above all) must be revalidated on every
    # load, or users keep seeing a stale page pointing at old bundles.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @page not path /assets/* /api/*
    header @page Cache-Control "no-cache"

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    # The subscription URL, on the standard port. It lived on :8443 only because
    # the control host used to double as a VPN exit and Xray held 443. A
    # non-standard port is the first thing censors, corporate networks and public
    # Wi-Fi drop — which would strand a paying user whose client cannot refresh
    # its config. Keep any old host:8443 block serving too: clients already have
    # those URLs saved and will keep polling them.
    handle /sub/* {
        reverse_proxy 127.0.0.1:8080
    }
    handle /sub-safe/* {
        reverse_proxy 127.0.0.1:8080
    }
    handle /sub-fast/* {
        reverse_proxy 127.0.0.1:8080
    }
    @english path /en /en/*
    handle @english {
        root * /srv/web
        try_files {path} {path}/ /en/index.html
        file_server
    }
    handle {
        root * /srv/web
        try_files {path} {path}/ /ru/index.html
        file_server
    }
}

# Optional outbound node-control virtual host. The glob is empty on legacy
# installs. Enable it by copying control-plane/control.caddy.example to
# data/control/server/control.caddy and setting CONTROL_DOMAIN.
import /etc/caddy/control/*.caddy
