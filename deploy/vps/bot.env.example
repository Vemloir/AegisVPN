BOT_TOKEN=123456:replace_me
ADMIN_IDS=[123456789]
PUBLIC_BASE_URL=https://vpn.example.com:8443
# The public website (apex domain only — the Telegram Login Widget works on the
# one domain registered via BotFather). Payment providers send the payer back here.
SITE_PUBLIC_URL=https://site.example.com
# Where subscription URLs are handed to clients. Keep this on the STANDARD port:
# a non-standard one (:8443) is the first thing censors, corporate networks and
# public Wi-Fi drop, and a client that cannot refresh its config strands a paying
# user. Only put a port here if 443 on this host is taken by something else (it
# is, if the host also runs a VPN exit). Changing this does not break existing
# clients — they keep polling the URL they already saved, so the old host must
# keep serving.
SUBSCRIPTION_PUBLIC_BASE_URL=https://site.example.com
TELEGRAM_MODE=polling
AUTO_INIT_DB=true
DATABASE_URL=sqlite+aiosqlite:////data/aegis.db
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
SITE_TITLE=Aegis VPN
SITE_DESCRIPTION=VPN landing page, plans, and subscription links
BOOTSTRAP_SERVER_NAME=Main
BOOTSTRAP_SERVER_FLAG=EU
BOOTSTRAP_SERVER_AGENT_ENV=/vpn-data/agent.env
BOOTSTRAP_SERVER_AGENT_URL=http://127.0.0.1:8444
BOOTSTRAP_SERVER_WAIT_SECONDS=60
BOOTSTRAP_PLANS_JSON=[{"days":30,"stars_price":100}]
LOG_LEVEL=INFO
# Caddy reads the same 0600 file and injects it only on loopback requests after
# successfully verifying the node's client certificate.
NODE_CONTROL_PROXY_SECRET_FILE=/control/proxy-secret
NODE_CONTROL_LONG_POLL_SECONDS=25
NODE_CONTROL_POLL_INTERVAL_SECONDS=1
NODE_CONTROL_PAGE_SIZE=500
NODE_CONTROL_MAX_TELEMETRY_BYTES=1048576
# Platega (СБП / RUB). Both must be set for the СБП button to go live; the
# secret lives ONLY here on the server, never in the repo. Callback URL to set in
# the Platega dashboard: <PUBLIC_BASE_URL>/payment/platega/callback
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
