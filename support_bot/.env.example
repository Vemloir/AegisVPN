# Token of the support bot (@AegisVPNsupportBot) issued by @BotFather.
# SECRET — never commit. If it ever leaks, /revoke in @BotFather and put the new one here.
SUPPORT_BOT_TOKEN=

# Operator Telegram numeric IDs that receive tickets and answer them.
# Same people as the main bot's ADMIN_IDS. JSON list:
ADMIN_IDS=[123456789]

# Persistent sqlite (ticket -> user mapping). Lives on the mounted /data volume.
DB_PATH=/data/support.db

LOG_LEVEL=INFO
